---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  badge?: string;
  subtitle?: string;
  updatedAt?: string;
  canonicalPath?: string;
}

const {
  title,
  badge = 'Documento Legal Oficial',
  subtitle = 'Conforme a la Ley N° 29733 de Protección de Datos Personales',
  updatedAt = 'Noviembre 2026',
  canonicalPath = ''
} = Astro.props;
---

<BaseLayout title={title} canonicalPath={canonicalPath}>
  <div class="legal-wrapper">
    <div class="container legal-container">
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>

      <header class="legal-header">
        <span class="badge">{badge}</span>
        <h1 class="legal-title">{title}</h1>
        <p class="legal-subtitle">{subtitle}</p>
        <p class="legal-meta">Última actualización: {updatedAt} | VIP Center Fit — Juliaca, Perú</p>
      </header>

      <article class="legal-card card">
        <slot />
      </article>

      <div class="legal-nav-footer">
        <a href="/" class="btn btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Volver al Portal Principal
        </a>
        <a href="/descargar" class="btn btn-outline-gold">
          Descargar App Móvil
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .legal-wrapper {
    padding: 40px 0 80px 0;
  }

  .legal-container {
    max-width: 900px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .breadcrumb a:hover {
    color: var(--gold-primary);
  }

  .legal-header {
    margin-bottom: 32px;
  }

  .legal-title {
    font-size: 32px;
    margin-top: 12px;
    margin-bottom: 8px;
    color: var(--text-primary);
  }

  .legal-subtitle {
    font-size: 16px;
    color: var(--gold-primary);
    font-weight: 500;
    margin-bottom: 8px;
  }

  .legal-meta {
    font-size: 13px;
    color: var(--text-muted);
  }

  .legal-card {
    padding: 36px;
    background: var(--bg-card);
    line-height: 1.7;
  }

  .legal-card :global(h2) {
    color: var(--gold-primary);
    font-size: 20px;
    margin-top: 32px;
    margin-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 8px;
  }

  .legal-card :global(h2:first-of-type) {
    margin-top: 0;
  }

  .legal-card :global(h3) {
    font-size: 17px;
    color: var(--text-primary);
    margin-top: 20px;
    margin-bottom: 8px;
  }

  .legal-card :global(p) {
    margin-bottom: 16px;
    color: var(--text-secondary);
  }

  .legal-card :global(ul), .legal-card :global(ol) {
    margin-bottom: 16px;
    padding-left: 24px;
    color: var(--text-secondary);
  }

  .legal-card :global(li) {
    margin-bottom: 8px;
  }

  .legal-card :global(strong) {
    color: var(--text-primary);
  }

  .legal-card :global(code) {
    background: rgba(255, 255, 255, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 13px;
    color: var(--gold-primary);
  }

  .legal-nav-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 36px;
  }

  @media (max-width: 640px) {
    .legal-card {
      padding: 20px;
    }

    .legal-title {
      font-size: 26px;
    }
  }
</style>
