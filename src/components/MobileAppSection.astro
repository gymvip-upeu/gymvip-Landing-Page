---
import QrCode from './QrCode.astro';
import { GitHubReleaseAdapter } from '../core/adapters/GitHubReleaseAdapter';
import { GetAndroidReleaseUseCase } from '../core/usecases/GetAndroidReleaseUseCase';

const releaseUseCase = new GetAndroidReleaseUseCase(new GitHubReleaseAdapter());
const release = await releaseUseCase.execute();
---

<section id="app-movil" class="section section-warm" aria-labelledby="app-heading">
  <div class="container">
    <div class="app-showcase-grid">
      <div class="app-copy-col">
        <span class="eyebrow">EXPERIENCIA CONECTADA · ANDROID APK {release.releaseTag}</span>
        <h2 id="app-heading" class="section-title app-title">
          App VIP CENTER FIT: tu membresía y club <span class="accent">dentro y fuera de sala</span>
        </h2>
        <p class="app-intro">
          Lleva tu carnet digital contigo incluso sin cobertura de datos (SQLite offline), escanea el código QR de recepción en segundos, revisa tus días restantes y reserva productos del stand de suplementos.
        </p>

        <ul class="app-bullets">
          <li><strong>Carnet Digital &amp; QR Dinámico:</strong> Acceso seguro con validación temporal en torniquete.</li>
          <li><strong>Seguridad Biométrica:</strong> Desbloqueo por huella o rostro y cierre remoto de otras sesiones.</li>
          <li><strong>Suplementos y Avisos FCM:</strong> Reserva de stock por 30 minutos con ticket QR de retiro y notificaciones de vencimiento.</li>
        </ul>

        <div class="app-download-row">
          <div class="app-qr-card">
            <QrCode url="https://gymvip.vercel.app/descargar" size={142} label="Escanea para ir a /descargar" />
          </div>

          <div class="app-btn-stack">
            <a
              href={release.isAvailable ? release.downloadUrl : '/descargar'}
              download={release.isAvailable ? release.apkName : undefined}
              class="btn btn-dark app-dl-btn"
            >
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              <span>Descargar APK {release.releaseTag} ({release.apkSizeFormatted})</span>
            </a>

            <a href="/descargar" class="btn btn-outline-dark">
              Ver Ficha Técnica y SHA-256
            </a>

            <p class="app-store-honesty">
              Distribución directa vía APK oficial firmado (v2/v3) para Android 7.0+. No disponible en Google Play Store ni App Store.
            </p>
          </div>
        </div>
      </div>

      <div class="app-visual-col">
        <div class="phone-frame" aria-label="Vista previa referencial de la App Android GYM VIP">
          <div class="phone-notch" aria-hidden="true"></div>
          <div class="phone-screen">
            <div class="phone-topbar">
              <span class="phone-brand">GYM VIP</span>
              <span class="phone-pill-ok">VIGENTE</span>
            </div>

            <div class="phone-card-membership">
              <span class="phone-label">Membresía Activa</span>
              <strong>Plan Trimestral · Sede Juliaca</strong>
              <div class="phone-progress-bar">
                <div class="phone-progress-fill"></div>
              </div>
              <span class="phone-sub">Control de vigencia en America/Lima · Modo Offline activo</span>
            </div>

            <div class="phone-qr-preview">
              <div class="phone-qr-mini">
                <img
                  src="/images/exp-qr.webp"
                  alt="Ilustración de escaneo QR en App Móvil VIP CENTER FIT"
                  width="360"
                  height="220"
                  class="phone-preview-img"
                  loading="eager"
                  decoding="async"
                />
              </div>
              <div class="phone-qr-meta">
                <strong>Check-in QR Torniquete</strong>
                <span>Escanea el desafío rotativo en recepción</span>
              </div>
            </div>

            <div class="phone-quick-grid">
              <div class="phone-mini-tile">
                <span>Suplementos</span>
                <strong>Ticket QR rtk_</strong>
              </div>
              <div class="phone-mini-tile">
                <span>Biometría</span>
                <strong>Bloqueo Activo</strong>
              </div>
            </div>
          </div>
          <p class="phone-caption">Vista ilustrativa del ecosistema móvil Android v1.1.3</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .app-showcase-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    align-items: center;
  }

  .app-title {
    text-align: left;
  }

  .app-intro {
    font-size: 1.03rem;
    color: var(--vf-ink-soft);
    line-height: 1.65;
    margin-bottom: 1.35rem;
  }

  .app-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 1.85rem;
    font-size: 0.94rem;
    color: var(--vf-ink-soft);
  }

  .app-bullets li {
    padding-left: 1.35rem;
    position: relative;
  }

  .app-bullets li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--vf-gold-ink);
    font-weight: 800;
  }

  .app-download-row {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    background-color: #ffffff;
    border: 1px solid rgba(184, 134, 11, 0.28);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    box-shadow: var(--shadow-card);
  }

  .app-qr-card {
    flex-shrink: 0;
  }

  .app-btn-stack {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
  }

  .app-dl-btn {
    justify-content: center;
  }

  .app-store-honesty {
    font-size: 0.77rem;
    color: var(--vf-muted);
    line-height: 1.45;
  }

  .app-visual-col {
    display: flex;
    justify-content: center;
  }

  .phone-frame {
    width: 100%;
    max-width: 340px;
    background-color: #0b0d12;
    border: 2px solid var(--vf-gold);
    border-radius: 30px;
    padding: 1rem 0.9rem 1.2rem;
    box-shadow: var(--shadow-dark);
    color: #ffffff;
  }

  .phone-notch {
    width: 96px;
    height: 6px;
    background-color: #272b38;
    border-radius: 999px;
    margin: 0 auto 0.9rem;
  }

  .phone-screen {
    background-color: #141720;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .phone-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .phone-brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--vf-gold);
    letter-spacing: 0.06em;
  }

  .phone-pill-ok {
    background-color: rgba(16, 185, 129, 0.16);
    color: #34d399;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }

  .phone-card-membership {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.16), rgba(20, 23, 32, 0.95));
    border: 1px solid var(--vf-gold-border);
    border-radius: 14px;
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .phone-label {
    font-size: 0.7rem;
    color: var(--vf-gold);
    text-transform: uppercase;
    font-weight: 700;
  }

  .phone-card-membership strong {
    font-size: 0.95rem;
  }

  .phone-progress-bar {
    height: 6px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    overflow: hidden;
    margin: 0.25rem 0;
  }

  .phone-progress-fill {
    width: 78%;
    height: 100%;
    background: var(--vf-gold);
  }

  .phone-sub {
    font-size: 0.72rem;
    color: #a3abb9;
  }

  .phone-qr-preview {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 14px;
    overflow: hidden;
  }

  .phone-preview-img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    object-position: center 26%;
  }

  .phone-qr-meta {
    padding: 0.65rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .phone-qr-meta strong {
    font-size: 0.84rem;
  }

  .phone-qr-meta span {
    font-size: 0.72rem;
    color: #a3abb9;
  }

  .phone-quick-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .phone-mini-tile {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    padding: 0.6rem 0.7rem;
  }

  .phone-mini-tile span {
    display: block;
    font-size: 0.68rem;
    color: #a3abb9;
  }

  .phone-mini-tile strong {
    font-size: 0.78rem;
    color: var(--vf-gold);
  }

  .phone-caption {
    text-align: center;
    font-size: 0.73rem;
    color: #9ca3af;
    margin-top: 0.75rem;
  }

  @media (max-width: 960px) {
    .app-showcase-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .app-download-row {
      flex-direction: column;
      align-items: stretch;
    }

    .app-qr-card {
      margin: 0 auto;
    }
  }
</style>
