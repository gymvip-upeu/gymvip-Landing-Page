---
import { SITE_BRAND } from '../data/catalog';

export interface Props {
  variant?: 'landing' | 'dark';
}

const { variant = 'dark' } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/#planes', label: 'Planes' },
  { href: '/#instalaciones', label: 'Instalaciones' },
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#horarios', label: 'Horarios' },
  { href: '/descargar', label: 'App Móvil' },
  { href: '/contacto', label: 'Contacto' },
];
---

<header class={`site-header ${variant === 'landing' ? 'header-light' : 'header-dark'}`}>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="VIP CENTER FIT — Ir al inicio">
      <span class="brand-badge" aria-hidden="true">
        <svg viewBox="0 0 36 36" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="36" height="36" rx="9" fill="#0B0D12" stroke="#D4AF37" stroke-width="1.5" />
          <path d="M8 12.5L13 24L18 12.5" stroke="#D4AF37" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M21 12.5H27.5M21 12.5V24M21 18H26" stroke="#FFFFFF" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="brand-copy">
        <span class="brand-name">{SITE_BRAND.brandName}</span>
        <span class="brand-loc">JULIACA · {SITE_BRAND.ecosystemName}</span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label="Navegación principal">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="header-actions">
        <a
          href={SITE_BRAND.frontendUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-portal-link"
          title="Abrir Portal Administrativo y de Socios en una nueva pestaña"
        >
          Portal Web
        </a>
        <a href="/contacto" class="btn btn-primary btn-nav-cta">
          Consultar en Sede
        </a>
      </div>
    </nav>

    <div class="mobile-controls">
      <a href="/#planes" class="btn btn-primary btn-mobile-cta">Ver Planes</a>
      <button
        type="button"
        id="mobile-menu-toggle"
        class="menu-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-inner container">
      <ul class="mobile-nav-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="mobile-nav-link">{link.label}</a>
          </li>
        ))}
      </ul>
      <div class="mobile-drawer-actions">
        <a href="/descargar" class="btn btn-primary btn-full">Descargar App Android (APK v1.1.3)</a>
        <a href={SITE_BRAND.frontendUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-light btn-full">
          Abrir Portal Web (gymvip-frontend)
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer');

  function setDrawerState(open: boolean) {
    if (!toggleBtn || !drawer) return;
    toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
    drawer.classList.toggle('open', open);
  }

  toggleBtn?.addEventListener('click', () => {
    const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
    setDrawerState(!isOpen);
  });

  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setDrawerState(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setDrawerState(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 900;
    width: 100%;
    transition: box-shadow 0.2s ease;
  }

  .header-light {
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--vf-border);
    color: var(--vf-ink);
  }

  .header-dark {
    background-color: rgba(11, 13, 18, 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--vf-border-on-dark);
    color: var(--vf-text-on-dark);
  }

  .header-inner {
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
  }

  .brand-loc {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--vf-gold-ink);
    margin-top: 2px;
  }

  .header-dark .brand-loc {
    color: var(--vf-gold);
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.35rem;
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 600;
    padding: 0.4rem 0;
    position: relative;
    transition: color 0.18s ease;
  }

  .header-light .nav-link {
    color: var(--vf-ink-soft);
  }

  .header-light .nav-link:hover,
  .header-light .nav-link.active {
    color: var(--vf-ink);
  }

  .header-dark .nav-link {
    color: var(--vf-muted-on-dark);
  }

  .header-dark .nav-link:hover,
  .header-dark .nav-link.active {
    color: var(--vf-gold);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background-color: var(--vf-gold);
    border-radius: 2px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .btn-portal-link {
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-pill);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .header-light .btn-portal-link {
    color: var(--vf-ink);
    border: 1px solid var(--vf-border-strong);
  }

  .header-light .btn-portal-link:hover {
    background-color: var(--vf-bg-soft);
  }

  .header-dark .btn-portal-link {
    color: var(--vf-text-on-dark);
    border: 1px solid rgba(255, 255, 255, 0.22);
  }

  .header-dark .btn-portal-link:hover {
    border-color: var(--vf-gold);
    color: var(--vf-gold);
  }

  .btn-nav-cta {
    padding: 0.65rem 1.3rem;
    font-size: 0.88rem;
  }

  .mobile-controls {
    display: none;
    align-items: center;
    gap: 0.6rem;
  }

  .btn-mobile-cta {
    padding: 0.48rem 0.9rem;
    font-size: 0.8rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    border: 1px solid var(--vf-border);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .header-dark .menu-toggle {
    border-color: var(--vf-border-on-dark);
  }

  .mobile-drawer {
    display: none;
    background-color: var(--vf-bg-dark);
    color: var(--vf-text-on-dark);
    border-bottom: 1px solid var(--vf-gold-border);
    box-shadow: var(--shadow-dark);
  }

  .mobile-drawer.open {
    display: block;
  }

  .mobile-drawer-inner {
    padding-top: 1rem;
    padding-bottom: 1.5rem;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1.1rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.78rem 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--vf-text-on-dark);
    border-bottom: 1px solid var(--vf-border-on-dark);
  }

  .mobile-nav-link:hover {
    color: var(--vf-gold);
  }

  .mobile-drawer-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (max-width: 1060px) {
    .nav-desktop {
      display: none;
    }

    .mobile-controls {
      display: flex;
    }
  }
</style>
