---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand-logo" aria-label="VIP CENTER FIT">
          <span class="brand-badge">VIP</span>
          <span class="brand-title">VIP CENTER FIT</span>
        </a>
        <p class="brand-description">
          Sede Central en Juliaca, San Román, Puno — Perú. Sistema integral de gestión de entrenamiento, membresías presenciales y control de acceso seguro.
        </p>
        <div class="contact-brief">
          <p><strong>Atención Presencial:</strong> Lunes a Domingo</p>
          <p><strong>Consultas:</strong> <a href="mailto:soporte@gymvip.pe">soporte@gymvip.pe</a></p>
          <p><strong>Desarrollo:</strong> VIP DevStudio — Sede en Ñaña</p>
        </div>
      </div>

      <div class="footer-links-group">
        <h4 class="links-title">Plataforma</h4>
        <ul class="links-list">
          <li><a href="/#horarios">Horarios y Sede</a></li>
          <li><a href="/#membresias">Membresías</a></li>
          <li><a href="/#beneficios">Beneficios</a></li>
          <li><a href="/#preguntas">Preguntas Frecuentes</a></li>
          <li><a href="/descargar">Descargar App Móvil</a></li>
          <li><a href="https://gymvip-frontend.vercel.app/inicio" target="_blank" rel="noopener noreferrer">Acceso Personal / Socios</a></li>
        </ul>
      </div>

      <div class="footer-links-group">
        <h4 class="links-title">Legal y Cumplimiento</h4>
        <ul class="links-list">
          <li><a href="/privacidad">Política de Privacidad</a></li>
          <li><a href="/terminos">Términos y Condiciones</a></li>
          <li><a href="/aviso-legal">Aviso Legal</a></li>
          <li><a href="/eliminar-cuenta">Eliminación de Cuenta (ARCO)</a></li>
          <li><a href="/contacto">Canales de Contacto</a></li>
        </ul>
      </div>

      <div class="footer-links-group">
        <h4 class="links-title">Transparencia</h4>
        <ul class="links-list">
          <li><a href="/atribuciones">Atribuciones y Marca</a></li>
          <li><a href="/licencias">Licencias y SBOM</a></li>
          <li><span class="compliance-tag">Ley N° 29733 (Perú)</span></li>
          <li><span class="compliance-tag">Protección de Datos</span></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} VIP CENTER FIT — GYM VIP. Todos los derechos reservados.
      </p>
      <p class="dev-credits">
        Desarrollado por <strong>VIP DevStudio</strong> — <strong>Sede en Ñaña</strong> (UPeU, Lima). Contacto técnico: <a href="mailto:devteam@gymvip.pe">devteam@gymvip.pe</a>
      </p>
      <p class="disclaimer">
        Los cobros presenciales, emisión de comprobantes y altas biométricas se tramitan de forma exclusiva en el mostrador oficial de recepción.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-color);
    padding: 56px 0 28px 0;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
    }
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    color: var(--text-primary);
  }

  .brand-badge {
    background: linear-gradient(135deg, var(--gold-primary), var(--gold-dark));
    color: #000;
    font-weight: 800;
    font-size: 12px;
    padding: 3px 6px;
    border-radius: var(--radius-sm);
  }

  .brand-title {
    font-size: 16px;
    font-weight: 800;
  }

  .brand-description {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .contact-brief p {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .links-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--gold-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 16px;
  }

  .links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .links-list a {
    color: var(--text-secondary);
    font-size: 14px;
    transition: color var(--transition-fast);
  }

  .links-list a:hover {
    color: var(--gold-hover);
  }

  .compliance-tag {
    display: inline-block;
    font-size: 12px;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
  }

  .footer-bottom {
    border-top: 1px solid var(--border-color);
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    text-align: center;
  }

  .copyright {
    font-size: 13px;
    color: var(--text-muted);
  }

  .dev-credits {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .dev-credits a {
    color: var(--gold-primary);
    text-decoration: underline;
  }

  .disclaimer {
    font-size: 12px;
    color: var(--text-muted);
  }
</style>
