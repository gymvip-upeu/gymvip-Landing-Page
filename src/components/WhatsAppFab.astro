---
// ==============================================================================
// GYM VIP — Botón Flotante de WhatsApp con Menú Rápido (Estilo Smart Fit)
// Permite a cualquier visitante iniciar consulta comercial en 1 toque
// ==============================================================================

const WHATSAPP_PHONE = '51951000000';
---

<div class="whatsapp-fab-container" id="whatsapp-fab">
  {/* Menú de Consultas Rápidas */}
  <div class="whatsapp-menu" id="whatsapp-menu" aria-hidden="true">
    <div class="menu-header">
      <span class="menu-status-dot"></span>
      <div>
        <strong class="menu-title">Asesoría VIP Center Fit</strong>
        <span class="menu-subtitle">En línea · Juliaca, Puno</span>
      </div>
    </div>
    
    <div class="menu-options">
      <a 
        href={`https://wa.me/${WHATSAPP_PHONE}?text=Hola%20VIP%20Center%20Fit%2C%20quisiera%20informaci%C3%B3n%20sobre%20el%20Plan%20Mensual%20de%20S%2F%20120.`} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="menu-option"
      >
        <span>💬 Consultar Plan Mensual (S/ 120)</span>
      </a>

      <a 
        href={`https://wa.me/${WHATSAPP_PHONE}?text=Hola%20VIP%20Center%20Fit%2C%20quisiera%20inscribirme%20en%20el%20Plan%20Black%20VIP%20Anual%20(S%2F%201%2C100).`} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="menu-option highlight"
      >
        <span>⭐ Inscribirme en Plan Black VIP (S/ 1,100)</span>
      </a>

      <a 
        href={`https://wa.me/${WHATSAPP_PHONE}?text=Hola%20VIP%20Center%20Fit%2C%20deseo%20conocer%20la%20ubicaci%C3%B3n%20exacta%20y%20hacer%20un%20recorrido%20en%20sede.`} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="menu-option"
      >
        <span>📍 Visitar Sede en Juliaca</span>
      </a>
    </div>
  </div>

  {/* Botón Flotante Pulsante */}
  <button 
    type="button" 
    id="whatsapp-fab-btn" 
    class="whatsapp-fab-btn" 
    aria-label="Abrir chat de WhatsApp de VIP Center Fit"
    aria-expanded="false"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
    <span class="online-indicator"></span>
  </button>
</div>

<script>
  function setupWhatsAppFab() {
    const fabBtn = document.getElementById('whatsapp-fab-btn');
    const fabMenu = document.getElementById('whatsapp-menu');

    if (!fabBtn || !fabMenu) return;

    fabBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = fabMenu.classList.contains('open');
      if (isOpen) {
        fabMenu.classList.remove('open');
        fabMenu.setAttribute('aria-hidden', 'true');
        fabBtn.setAttribute('aria-expanded', 'false');
      } else {
        fabMenu.classList.add('open');
        fabMenu.setAttribute('aria-hidden', 'false');
        fabBtn.setAttribute('aria-expanded', 'true');
      }
    });

    document.addEventListener('click', (e) => {
      if (!fabMenu.contains(e.target as Node) && e.target !== fabBtn) {
        fabMenu.classList.remove('open');
        fabMenu.setAttribute('aria-hidden', 'true');
        fabBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupWhatsAppFab);
  setupWhatsAppFab();
</script>

<style>
  .whatsapp-fab-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .whatsapp-fab-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    color: #fff;
    border: none;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4), 0 0 15px rgba(212, 175, 55, 0.2);
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .whatsapp-fab-btn:hover {
    transform: scale(1.08);
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.6);
  }

  .online-indicator {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 14px;
    height: 14px;
    background: #10b981;
    border: 2px solid #0a0a0c;
    border-radius: 50%;
  }

  .whatsapp-menu {
    width: 290px;
    background: #141418;
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: var(--radius-md);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.8), 0 0 20px rgba(212, 175, 55, 0.15);
    margin-bottom: 12px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px) scale(0.95);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .whatsapp-menu.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .menu-header {
    background: linear-gradient(90deg, #1c1c24 0%, #121008 100%);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .menu-status-dot {
    width: 10px;
    height: 10px;
    background: #25D366;
    border-radius: 50%;
    box-shadow: 0 0 8px #25D366;
  }

  .menu-title {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: #fff;
  }

  .menu-subtitle {
    font-size: 11px;
    color: #94A3B8;
  }

  .menu-options {
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .menu-option {
    display: block;
    padding: 10px 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 500;
    transition: all 0.15s ease;
  }

  .menu-option:hover {
    background: rgba(212, 175, 55, 0.15);
    border-color: var(--gold-primary);
    color: var(--gold-primary);
  }

  .menu-option.highlight {
    background: rgba(212, 175, 55, 0.08);
    border-color: rgba(212, 175, 55, 0.3);
  }
</style>
