---
// ==============================================================================
// GYM VIP — Barra Promocional Superior (Estilo Smart Fit)
// ==============================================================================
---

<div class="promo-ticker" role="region" aria-label="Aviso promocional oficial">
  <div class="container promo-container">
    <div class="promo-content">
      <span class="promo-badge">⚡ PROMOCIÓN SEDE JULIACA</span>
      <span class="promo-text">
        <strong>¡Sin costo de inscripción!</strong> Entrena en el gimnasio de alta gama más completo desde <strong>S/ 120 al mes</strong>
      </span>
    </div>
    <a href="/#planes" class="promo-link">
      <span>Ver Planes</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</div>

<style>
  .promo-ticker {
    background: linear-gradient(90deg, #121008 0%, #261e08 50%, #121008 100%);
    border-bottom: 1px solid rgba(212, 175, 55, 0.35);
    color: #f4f4f8;
    padding: 8px 16px;
    font-size: 13px;
    position: relative;
    z-index: 101;
  }

  .promo-container {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .promo-content {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .promo-badge {
    background: #d4af37;
    color: #0b0b0c;
    font-size: 11px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .promo-text strong {
    color: #d4af37;
  }

  .promo-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #d4af37;
    font-weight: 700;
    text-decoration: none;
    font-size: 12px;
    white-space: nowrap;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .promo-link:hover {
    color: #f3c64c;
    transform: translateX(3px);
  }

  @media (max-width: 768px) {
    .promo-ticker {
      font-size: 11.5px;
      padding: 6px 12px;
    }
    .promo-badge {
      display: none;
    }
  }
</style>
