---
import { SITE_BRAND } from '../data/catalog';
---

<section class="section section-dark cta-band" aria-labelledby="cta-final-heading">
  <div class="container">
    <div class="cta-box">
      <div class="cta-copy">
        <span class="eyebrow hero-dark-pill">COMIENZA EN {SITE_BRAND.sedeNombre.toUpperCase()}</span>
        <h2 id="cta-final-heading" class="section-title cta-heading">
          ¿Listo para comenzar tu entrenamiento en <span class="accent">{SITE_BRAND.brandName}?</span>
        </h2>
        <p class="cta-desc">
          Visítanos en Juliaca para confirmar tu plan presencial con comprobante inmediato, descarga la App Android oficial o accede al Portal Web si eres administrador o socio activo.
        </p>
      </div>

      <div class="cta-actions">
        <a href="/contacto" class="btn btn-primary">Consultar Planes en Sede</a>
        <a href="/descargar" class="btn btn-outline-light">Descargar APK v1.1.3</a>
        <a href={SITE_BRAND.frontendUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-light">
          Portal Web
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding: 4rem 0;
    background: linear-gradient(135deg, #0b0d12 0%, #171b26 100%);
    border-top: 1px solid var(--vf-gold-border);
  }

  .cta-box {
    border: 1px solid var(--vf-gold-border);
    border-radius: var(--radius-lg);
    padding: 2.75rem 2.25rem;
    background: rgba(20, 23, 32, 0.92);
    text-align: center;
    box-shadow: var(--shadow-dark);
  }

  .cta-copy {
    max-width: 720px;
    margin: 0 auto 1.75rem;
  }

  .cta-heading {
    margin-bottom: 0.75rem;
  }

  .cta-desc {
    color: var(--vf-muted-on-dark);
    font-size: 1rem;
    line-height: 1.65;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }
</style>
