---
// ==============================================================================
// GYM VIP — Sección de Sede Juliaca (Localizador Estilo Smart Fit)
// Ubicación exacta, horarios, comodidades y mapa interactivo
// ==============================================================================

const GOOGLE_MAPS_URL = 'https://maps.google.com/?q=-15.4988,-70.1332';
const WHATSAPP_RECEPCION_URL = 'https://wa.me/51951000000?text=Hola%20VIP%20Center%20Fit%2C%20quisiera%20consultar%20sobre%20la%20ubicaci%C3%B3n%20y%20visita%20a%20la%20Sede%20Juliaca.';
---

<section id="sede" class="section sede-section">
  <div class="container">
    <div class="section-header text-center">
      <span class="badge">NUESTRA UNIDAD</span>
      <h2 class="section-title">
        Sede Central <span class="gold-gradient-text">Juliaca</span>
      </h2>
      <p class="section-subtitle">
        Ubicación céntrica y de fácil acceso en la provincia de San Román, Puno. Diseñada para ofrecer confort y equipamiento de alta competencia.
      </p>
    </div>

    <div class="sede-grid">
      {/* Tarjeta de Información de Sede */}
      <div class="sede-info-card">
        <div class="sede-header-row">
          <div>
            <span class="sede-tag">SEDE PRINCIPAL</span>
            <h3 class="sede-title">VIP Center Fit — Sede San Martín</h3>
            <p class="sede-address">
              📍 Jr. San Martín con Jr. Mariano Núñez, Centro Histórico de Juliaca, San Román, Puno, Perú.
            </p>
          </div>
        </div>

        <div class="sede-divider"></div>

        {/* Horarios */}
        <div class="sede-block">
          <h4 class="block-title">🕒 Horarios de Entrenamiento</h4>
          <ul class="schedule-list">
            <li>
              <span>Lunes a Viernes:</span>
              <strong>06:00 a 22:00 hrs</strong>
            </li>
            <li>
              <span>Sábados:</span>
              <strong>06:00 a 20:00 hrs</strong>
            </li>
            <li>
              <span>Domingos y Feriados:</span>
              <strong>08:00 a 14:00 hrs</strong>
            </li>
          </ul>
        </div>

        <div class="sede-divider"></div>

        {/* Comodidades de la sede */}
        <div class="sede-block">
          <h4 class="block-title">✨ Comodidades Incluidas en Sede</h4>
          <div class="amenities-grid">
            <div class="amenity-item">
              <span class="amenity-icon">📶</span>
              <span>Wi-Fi Libre de Alta Velocidad</span>
            </div>
            <div class="amenity-item">
              <span class="amenity-icon">🚿</span>
              <span>Duchas con Agua Caliente</span>
            </div>
            <div class="amenity-item">
              <span class="amenity-icon">🔐</span>
              <span>Casilleros y Lockers Seguros</span>
            </div>
            <div class="amenity-item">
              <span class="amenity-icon">💧</span>
              <span>Dispensador de Agua Filtrada</span>
            </div>
            <div class="amenity-item">
              <span class="amenity-icon">🚗</span>
              <span>Zona de Estacionamiento</span>
            </div>
            <div class="amenity-item">
              <span class="amenity-icon">🛡️</span>
              <span>Torniquete con QR Criptográfico</span>
            </div>
          </div>
        </div>

        <div class="sede-actions">
          <a href={GOOGLE_MAPS_URL} target="_blank" rel="noopener noreferrer" class="btn btn-secondary sede-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
              <line x1="8" y1="2" x2="8" y2="18"></line>
              <line x1="16" y1="6" x2="16" y2="22"></line>
            </svg>
            Abrir en Google Maps
          </a>

          <a href={WHATSAPP_RECEPCION_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary sede-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            Contactar por WhatsApp
          </a>
        </div>
      </div>

      {/* Visualización Visual de Sede / Recorrido */}
      <div class="sede-visual-card">
        <div class="visual-badge">SEDE TOTALMENTE RENOVADA</div>
        <div class="visual-content">
          <span class="visual-stat">1,200 m²</span>
          <span class="visual-stat-label">Área total de entrenamiento distribuida en 3 niveles de alta capacidad</span>
          <div class="visual-chips">
            <span class="v-chip">Musculación</span>
            <span class="v-chip">Cardio Cinema</span>
            <span class="v-chip">Spinning</span>
            <span class="v-chip">Suplementos</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sede-section {
    background: #0d0d10;
  }

  .text-center {
    text-align: center;
  }

  .sede-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 28px;
    margin-top: 24px;
  }

  .sede-info-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }

  .sede-tag {
    font-size: 11px;
    font-weight: 800;
    color: var(--gold-primary);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .sede-title {
    font-size: 22px;
    font-weight: 800;
    color: #fff;
    margin: 4px 0 6px 0;
  }

  .sede-address {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .sede-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
  }

  .block-title {
    font-size: 14.5px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
  }

  .schedule-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .schedule-list li {
    display: flex;
    justify-content: space-between;
    font-size: 13.5px;
    color: var(--text-secondary);
  }

  .schedule-list strong {
    color: var(--gold-primary);
    font-weight: 700;
  }

  .amenities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .amenity-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.02);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .amenity-icon {
    font-size: 16px;
  }

  .sede-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  .sede-btn {
    flex: 1;
    min-width: 180px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    padding: 12px 18px;
  }

  .sede-visual-card {
    background: linear-gradient(135deg, rgba(20, 20, 24, 0.9) 0%, rgba(36, 36, 48, 0.8) 100%),
                radial-gradient(circle at 80% 20%, rgba(212, 175, 55, 0.25) 0%, transparent 60%);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: var(--radius-lg);
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }

  .visual-badge {
    align-self: flex-start;
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid rgba(212, 175, 55, 0.4);
    color: var(--gold-primary);
    font-size: 11px;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 20px;
    letter-spacing: 0.5px;
  }

  .visual-stat {
    display: block;
    font-size: 48px;
    font-weight: 900;
    color: #fff;
    line-height: 1;
    margin-bottom: 8px;
    letter-spacing: -1px;
  }

  .visual-stat-label {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .visual-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 24px;
  }

  .v-chip {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--gold-primary);
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 900px) {
    .sede-grid {
      grid-template-columns: 1fr;
    }
    .amenities-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
