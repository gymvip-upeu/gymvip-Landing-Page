---
import { SITE_BRAND } from '../data/catalog';
---

<section class="sede-band section-light" aria-labelledby="sede-heading">
  <div class="container sede-title-wrap">
    <h2 id="sede-heading" class="section-title sede-heading">
      Entrena en nuestra <span class="accent">{SITE_BRAND.sedeNombre}</span>
    </h2>
    <p class="sede-sub">{SITE_BRAND.sedeNotaUbicacion}</p>
  </div>

  <div class="sede-backdrop">
    <img
      src="/images/hero-athlete.webp"
      alt="Ambiente VIP CENTER FIT Juliaca"
      width="693"
      height="442"
      class="sede-bg-img"
      loading="eager"
      decoding="async"
    />
    <div class="sede-bg-overlay"></div>

    <div class="container sede-card-container">
      <div class="sede-pill-bar">
        <div class="sede-info-col">
          <div class="sede-status-row">
            <span class="sede-pin" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            <div>
              <strong class="sede-city">{SITE_BRAND.sedeCiudad}</strong>
              <span class="sede-status-badge" id="sede-live-status">
                Horarios: L–V 06:00–22:00 · Sáb 07:00–20:00 · Dom 08:00–14:00
              </span>
            </div>
          </div>
        </div>

        <div class="sede-actions-col">
          <a href="#horarios" class="sede-secondary-link">Ver Horarios</a>
          <a href="/contacto" class="btn btn-primary sede-cta-btn">
            Cómo Contratar en Sede
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const statusEl = document.getElementById('sede-live-status');
  if (statusEl) {
    try {
      const nowLima = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Lima' }));
      const day = nowLima.getDay(); // 0=Dom, 1..5=L-V, 6=Sab
      const minutes = nowLima.getHours() * 60 + nowLima.getMinutes();

      let schedule = { open: 6 * 60, close: 22 * 60, label: 'Hoy L–V: 06:00 – 22:00' };
      if (day === 6) schedule = { open: 7 * 60, close: 20 * 60, label: 'Hoy Sábado: 07:00 – 20:00' };
      if (day === 0) schedule = { open: 8 * 60, close: 14 * 60, label: 'Hoy Domingo: 08:00 – 14:00' };

      const isOpen = minutes >= schedule.open && minutes < schedule.close;
      statusEl.textContent = `${isOpen ? 'Recepción abierta ahora' : 'Fuera de horario presencial'} · ${schedule.label} (UTC-5)`;
      statusEl.classList.add(isOpen ? 'status-open' : 'status-closed');
    } catch {
      // Fallback estático ya presente
    }
  }
</script>

<style>
  .sede-band {
    padding-top: 3.25rem;
    padding-bottom: 0;
  }

  .sede-title-wrap {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .sede-heading {
    margin-bottom: 0.45rem;
  }

  .sede-sub {
    color: var(--vf-muted);
    font-size: 0.96rem;
  }

  .sede-backdrop {
    position: relative;
    overflow: hidden;
    padding: 3.1rem 0;
    background-color: var(--vf-bg-dark);
  }

  .sede-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    opacity: 0.35;
  }

  .sede-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 13, 18, 0.78), rgba(11, 13, 18, 0.9));
  }

  .sede-card-container {
    position: relative;
    z-index: 2;
  }

  .sede-pill-bar {
    max-width: 980px;
    margin: 0 auto;
    background-color: #ffffff;
    color: var(--vf-ink);
    border-radius: var(--radius-pill);
    padding: 0.85rem 1rem 0.85rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.45);
    border: 2px solid var(--vf-gold);
  }

  .sede-status-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .sede-pin {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(212, 175, 55, 0.16);
    color: var(--vf-gold-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sede-city {
    display: block;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 800;
    color: var(--vf-ink);
  }

  .sede-status-badge {
    display: block;
    font-size: 0.84rem;
    color: var(--vf-muted);
    margin-top: 2px;
  }

  .sede-status-badge.status-open {
    color: var(--vf-success);
    font-weight: 600;
  }

  .sede-actions-col {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .sede-secondary-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--vf-ink-soft);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .sede-secondary-link:hover {
    color: var(--vf-gold-ink);
  }

  .sede-cta-btn {
    padding: 0.82rem 1.45rem;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .sede-pill-bar {
      border-radius: 22px;
      padding: 1.25rem;
      flex-direction: column;
      align-items: stretch;
    }

    .sede-actions-col {
      flex-direction: column;
      align-items: stretch;
    }

    .sede-secondary-link {
      text-align: center;
    }
  }
</style>
