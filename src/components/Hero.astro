---
const WEB_APP_URL = 'https://gymvip-frontend.vercel.app/inicio';
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-badge-wrapper">
      <span class="badge">Sede Oficial — Juliaca, San Román, Puno</span>
    </div>

    <h1 class="hero-title">
      Disciplina, Rendimiento y <span class="gold-gradient-text">Experiencia VIP</span>
    </h1>

    <p class="hero-subtitle">
      Plataforma tecnológica unificada de VIP Center Fit. Acceso con QR dinámico criptográfico, cobros y liquidación transparente en mostrador y app móvil nativa para socios.
    </p>

    <div class="hero-actions">
      <a href="/descargar" class="btn btn-primary hero-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Descargar App Android
      </a>

      <a 
        href={WEB_APP_URL} 
        class="btn btn-secondary hero-btn"
        target="_blank" 
        rel="noopener noreferrer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
          <polyline points="10 17 15 12 10 7"/>
          <line x1="15" y1="12" x2="3" y2="12"/>
        </svg>
        Ingresar a la Plataforma Web
      </a>
    </div>

    <div class="hero-highlights">
      <div class="highlight-item">
        <div class="highlight-icon">🔒</div>
        <div class="highlight-text">
          <strong>Acceso QR Dinámico</strong>
          <span>Seguridad anti-fraude en torniquetes</span>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon">💳</div>
        <div class="highlight-text">
          <strong>Liquidación en Recepción</strong>
          <span>Sin cargos recurrentes no autorizados</span>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon">📱</div>
        <div class="highlight-text">
          <strong>App Móvil Oficial</strong>
          <span>Avisos, membresías y catálogo</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 80px 0 60px 0;
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at 50% 20%, rgba(212, 175, 55, 0.08) 0%, rgba(10, 10, 12, 0) 70%);
  }

  .hero-container {
    text-align: center;
    max-width: 900px;
  }

  .hero-badge-wrapper {
    margin-bottom: 24px;
  }

  .hero-title {
    font-size: 38px;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .gold-gradient-text {
    background: linear-gradient(135deg, var(--gold-hover) 0%, var(--gold-primary) 50%, var(--gold-dark) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 18px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 36px;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 56px;
  }

  .hero-btn {
    padding: 14px 28px;
    font-size: 16px;
  }

  .hero-highlights {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding-top: 36px;
    border-top: 1px solid var(--border-color);
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 52px;
    }

    .hero-subtitle {
      font-size: 20px;
    }

    .hero-highlights {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 14px;
    text-align: left;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    padding: 16px 20px;
    border-radius: var(--radius-md);
  }

  .highlight-icon {
    font-size: 24px;
  }

  .highlight-text strong {
    display: block;
    font-size: 14px;
    color: var(--text-primary);
  }

  .highlight-text span {
    font-size: 12px;
    color: var(--text-muted);
  }
</style>
