---
const WEB_APP_URL = 'https://gymvip-frontend.vercel.app/inicio';
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-badge-wrapper">
      <span class="badge">👑 VIP CENTER FIT · SEDE CENTRAL JULIACA</span>
    </div>

    <h1 class="hero-title">
      El Gimnasio de Alta Gama que Transforma tu Vida en <span class="gold-gradient-text">Juliaca</span>
    </h1>

    <p class="hero-subtitle">
      Espacios climatizados, máquinas de última generación, instructores certificados y acceso digital inteligente con código QR en tu celular. ¡Sin contratos de permanencia forzada en plan mensual!
    </p>

    {/* Selector Rápido de Objetivos (Estilo Smart Fit) */}
    <div class="hero-goals-selector">
      <span class="goals-label">¿Cuál es tu objetivo principal?</span>
      <div class="goals-chips">
        <a href="#planes" class="goal-chip">💪 Hipertrofia & Musculación</a>
        <a href="#planes" class="goal-chip">🔥 Quema de Grasa & Cardio</a>
        <a href="#planes" class="goal-chip">🧘 Salud & Vitalidad Integral</a>
      </div>
    </div>

    <div class="hero-actions">
      <a href="#planes" class="btn btn-primary hero-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        ¡Ver Planes desde S/ 120/mes!
      </a>

      <a href="/descargar" class="btn btn-secondary hero-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Descargar App Android
      </a>
    </div>

    <div class="hero-highlights">
      <div class="highlight-item">
        <div class="highlight-icon">🔒</div>
        <div class="highlight-text">
          <strong>Acceso QR en 2 Segundos</strong>
          <span>Torniquete inteligente anti-filas</span>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon">💳</div>
        <div class="highlight-text">
          <strong>Sin Débitos Automáticos Sorpresa</strong>
          <span>Tú decides cómo y cuándo renovar</span>
        </div>
      </div>

      <div class="highlight-item">
        <div class="highlight-icon">🚿</div>
        <div class="highlight-text">
          <strong>Duchas de Agua Caliente y Lockers</strong>
          <span>Comodidad y seguridad para tus cosas</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 80px 0 60px 0;
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at 50% 20%, rgba(212, 175, 55, 0.08) 0%, rgba(10, 10, 12, 0) 70%);
  }

  .hero-container {
    text-align: center;
    max-width: 900px;
  }

  .hero-badge-wrapper {
    margin-bottom: 24px;
  }

  .hero-title {
    font-size: 38px;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .gold-gradient-text {
    background: linear-gradient(135deg, var(--gold-hover) 0%, var(--gold-primary) 50%, var(--gold-dark) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 18px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 36px;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-goals-selector {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: var(--radius-md);
    padding: 14px 20px;
    margin: 0 auto 36px auto;
    max-width: 680px;
  }

  .goals-label {
    display: block;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--text-muted);
    margin-bottom: 10px;
    font-weight: 700;
  }

  .goals-chips {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .goal-chip {
    background: rgba(212, 175, 55, 0.08);
    border: 1px solid rgba(212, 175, 55, 0.3);
    color: var(--gold-primary);
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .goal-chip:hover {
    background: var(--gold-primary);
    color: #000;
    transform: translateY(-2px);
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 56px;
  }

  .hero-btn {
    padding: 14px 28px;
    font-size: 16px;
  }

  .hero-highlights {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding-top: 36px;
    border-top: 1px solid var(--border-color);
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 52px;
    }

    .hero-subtitle {
      font-size: 20px;
    }

    .hero-highlights {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 14px;
    text-align: left;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    padding: 16px 20px;
    border-radius: var(--radius-md);
  }

  .highlight-icon {
    font-size: 24px;
  }

  .highlight-text strong {
    display: block;
    font-size: 14px;
    color: var(--text-primary);
  }

  .highlight-text span {
    font-size: 12px;
    color: var(--text-muted);
  }
</style>
