<LegalLayout
  title="Política de Privacidad y Tratamiento de Datos Personales"
  badge="Ley N° 29733 (Perú)"
  subtitle="Normativa de Protección de Datos y Privacidad en Aplicaciones Móviles"
  updatedAt="14 de Noviembre de 2026 | Versión v1.0"
