---
import BaseLayout from '../layouts/BaseLayout.astro';
import QrCode from '../components/QrCode.astro';
import { GitHubReleaseAdapter } from '../core/adapters/GitHubReleaseAdapter';
import { GetAndroidReleaseUseCase } from '../core/usecases/GetAndroidReleaseUseCase';

const adapter = new GitHubReleaseAdapter();
const getRelease = new GetAndroidReleaseUseCase(adapter);
const release = await getRelease.execute();

const portalDownloadUrl = 'https://gymvip.vercel.app/descargar';
---

<BaseLayout
  title={`Descargar App Android ${release.releaseTag}`}
  description={`Descarga oficial del paquete Android ${release.apkName} (${release.version}) para socios de VIP CENTER FIT con firma v2/v3 y verificación SHA-256.`}
  canonicalPath="/descargar"
  theme="dark"
>
  <section class="dl-section">
    <div class="container">
      <div class="dl-header">
        <span class="eyebrow hero-dark-pill">DISTRIBUCIÓN OFICIAL ANDROID</span>
        <h1>GYM VIP Mobile — Android {release.releaseTag}</h1>
        <p class="dl-lead">
          Tu carnet digital offline, check-in por QR dinámico en recepción, catálogo de suplementos con retiro QR y alertas de membresía.
        </p>
      </div>

      <div class="dl-grid">
        <div class="card dl-main-card">
          <div class="dl-app-head">
            <div class="dl-app-icon">
              <img
                src="/images/gymvip-logo.webp"
                alt="Logotipo oficial VIP CENTER FIT"
                width="64"
                height="64"
                class="dl-logo-img"
              />
            </div>
            <div>
              <h2>GYM VIP Mobile <span class="pkg-id">(com.gymvip.mobile)</span></h2>
              <p class="dl-version">
                Versión {release.version} ({release.releaseTag}) · Compilado {release.releaseDate}
              </p>
              <span class:list={['dl-badge', release.isAvailable ? 'dl-badge-ok' : 'dl-badge-warn']}>
                {release.isAvailable
                  ? '● Paquete Release Universal Verificado (v2 & v3)'
                  : '○ Consulta en Releases Oficiales GitHub'}
              </span>
            </div>
          </div>

          <div class="dl-cta-wrap">
            {release.isAvailable ? (
              <a href={release.downloadUrl} download={release.apkName} class="btn btn-primary btn-full dl-btn">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="7 10 12 15 17 10" />
                  <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                <span>Descargar APK Oficial ({release.apkSizeFormatted})</span>
              </a>
            ) : (
              <a href={release.downloadUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-full dl-btn">
                <span>Abrir Releases Oficiales en GitHub</span>
              </a>
            )}
            <p class="dl-status-msg">{release.statusMessage}</p>
          </div>

          <div class="dl-specs">
            <h3>Ficha Técnica e Integridad Criptográfica</h3>
            <ul class="specs-list">
              <li>
                <span class="spec-label">Compatibilidad mínima</span>
                <span class="spec-value">{release.minAndroid}</span>
              </li>
              <li>
                <span class="spec-label">Arquitecturas ABI</span>
                <span class="spec-value">Universal (arm64-v8a, armeabi-v7a, x86, x86_64)</span>
              </li>
              <li>
                <span class="spec-label">Peso del archivo APK</span>
                <span class="spec-value">
                  {release.apkSizeFormatted} ({release.apkSizeBytes.toLocaleString('es-PE')} bytes)
                </span>
              </li>
              <li>
                <span class="spec-label">Esquema de firma</span>
                <span class="spec-value">{release.signatureScheme}</span>
              </li>
              <li>
                <span class="spec-label">API de producción</span>
                <span class="spec-value mono">{release.backendUrl}</span>
              </li>
              <li class="spec-hash-row">
                <div class="spec-hash-top">
                  <span class="spec-label">Checksum SHA-256 (archivo APK)</span>
                  <button type="button" id="copy-sha-btn" class="copy-btn" data-sha={release.sha256}>
                    Copiar SHA-256
                  </button>
                </div>
                <code class="hash-code" id="sha-value">{release.sha256}</code>
              </li>
            </ul>
          </div>
        </div>

        <aside class="dl-side-col">
          <div class="card dl-qr-card">
            <h3>Escanear desde tu Android</h3>
            <p class="qr-desc">
              Apunta la cámara de tu teléfono para abrir directamente esta ficha y descargar el paquete:
            </p>
            <div class="qr-center">
              <QrCode url={portalDownloadUrl} size={172} label="https://gymvip.vercel.app/descargar" />
            </div>
          </div>

          <div class="card dl-steps-card">
            <h3>Pasos de Instalación Segura</h3>
            <ol class="install-steps">
              <li>
                <span class="step-num">1</span>
                <span>Descarga <strong>{release.apkName}</strong> en tu equipo Android.</span>
              </li>
              <li>
                <span class="step-num">2</span>
                <span>Si tu dispositivo solicita autorización para instalar apps externas, activa <em>Permitir desde esta fuente</em> para tu navegador.</span>
              </li>
              <li>
                <span class="step-num">3</span>
                <span>Si tuviste una compilación de prueba anterior (<em>debug</em>), desinstálala previamente para evitar conflicto de firma oficial.</span>
              </li>
              <li>
                <span class="step-num">4</span>
                <span>Inicia sesión con las credenciales entregadas en recepción de Juliaca.</span>
              </li>
            </ol>

            <div class="alert-box dl-honest-alert">
              <strong>Distribución transparente:</strong> Esta aplicación no se distribuye en Google Play Store ni App Store; el instalador proviene únicamente del paquete oficial firmado por el equipo de ingeniería GYM VIP.
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-sha-btn');
  copyBtn?.addEventListener('click', async () => {
    const sha = copyBtn.getAttribute('data-sha') || '';
    try {
      await navigator.clipboard.writeText(sha);
      copyBtn.textContent = '¡SHA-256 copiado!';
      setTimeout(() => {
        copyBtn.textContent = 'Copiar SHA-256';
      }, 2200);
    } catch {
      copyBtn.textContent = 'Copia manual requerida';
    }
  });
</script>

<style>
  .dl-section {
    padding: 3.5rem 0 5rem;
  }

  .dl-header {
    text-align: center;
    max-width: 740px;
    margin: 0 auto 2.75rem;
  }

  .dl-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.8vw, 2.85rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .dl-lead {
    color: var(--vf-muted-on-dark);
    font-size: 1.05rem;
  }

  .dl-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2rem;
    align-items: start;
  }

  .dl-app-head {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    margin-bottom: 1.75rem;
  }

  .dl-app-icon {
    width: 68px;
    height: 68px;
    border-radius: 16px;
    overflow: hidden;
    border: 1.5px solid var(--vf-gold);
    flex-shrink: 0;
    background: #0b0d12;
  }

  .dl-logo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dl-app-head h2 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.2rem;
  }

  .dl-version {
    font-size: 0.9rem;
    color: var(--vf-gold);
    font-weight: 600;
    margin-bottom: 0.45rem;
  }

  .dl-badge {
    display: inline-block;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
  }

  .dl-badge-ok {
    background: rgba(16, 185, 129, 0.14);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.35);
  }

  .dl-badge-warn {
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.35);
  }

  .dl-cta-wrap {
    margin-bottom: 2rem;
    text-align: center;
  }

  .dl-btn {
    padding: 1rem 1.5rem;
    font-size: 1.02rem;
  }

  .dl-status-msg {
    margin-top: 0.75rem;
    font-size: 0.84rem;
    color: var(--vf-muted-on-dark);
  }

  .dl-specs h3 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--vf-border-on-dark);
    padding-bottom: 0.65rem;
  }

  .specs-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .specs-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.89rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 0.65rem;
  }

  .spec-label {
    color: var(--vf-muted-on-dark);
  }

  .spec-value {
    color: #ffffff;
    font-weight: 600;
    text-align: right;
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .spec-hash-row {
    flex-direction: column;
    align-items: stretch !important;
    border-bottom: none !important;
  }

  .spec-hash-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .copy-btn {
    background: rgba(212, 175, 55, 0.14);
    border: 1px solid var(--vf-gold-border);
    color: var(--vf-gold);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
  }

  .hash-code {
    display: block;
    background: rgba(0, 0, 0, 0.42);
    border: 1px solid var(--vf-border-on-dark);
    border-radius: 8px;
    padding: 0.65rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--vf-gold);
    word-break: break-all;
  }

  .dl-side-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .dl-qr-card,
  .dl-steps-card {
    text-align: left;
  }

  .dl-qr-card h3,
  .dl-steps-card h3 {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.6rem;
  }

  .qr-desc {
    font-size: 0.88rem;
    color: var(--vf-muted-on-dark);
    margin-bottom: 1.15rem;
  }

  .qr-center {
    display: flex;
    justify-content: center;
  }

  .install-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-top: 0.85rem;
  }

  .install-steps li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: #cbd5e1;
  }

  .step-num {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(212, 175, 55, 0.16);
    border: 1px solid var(--vf-gold-border);
    color: var(--vf-gold);
    font-weight: 800;
    font-size: 0.78rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dl-honest-alert {
    margin-bottom: 0;
    font-size: 0.83rem;
  }

  @media (max-width: 900px) {
    .dl-grid {
      grid-template-columns: 1fr;
    }

    .specs-list li {
      flex-direction: column;
      align-items: flex-start;
    }

    .spec-value {
      text-align: left;
    }
  }
</style>
